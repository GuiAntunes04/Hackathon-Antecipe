DATABASE_URL=postgresql://antecipe:senha_ficticia_exemplo@db:5432/antecipe
# postgres = lotes no PostgreSQL 16 (padrão Docker); json = data/lotes/*.json (dev sem DB)
PERSISTENCIA_LOTE=postgres
DATA_BASE=22/10/2026
CAMINHO_VALIDADORES=config/validadores_antecipe.json
# Mescla mock + estoque (scripts/mesclar_situacao_sacados.py); mock sozinho deixa lacunas
CAMINHO_SITUACAO=data/situacao_sacados.csv
# Opcional: 100% aderência ao estoque oficial (situação + concentração do gabarito)
# CAMINHO_GABARITO=resultado_esperado_100k.json
LOG_LEVEL=INFO
# true = demo na home (GET / e /validar/demo); POST /validar sempre usa o pipeline no CSV inteiro
MOCK_VALIDACAO=false
# Recusa 2ª+ linha com mesmo cedente, documento e valor no CSV (false = desliga, ex. vs gabarito)
DUPLICIDADE_LOTE=true
